<?xml version="1.0" encoding="UTF-8"?>
<extensioninfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="extensioninfo.xsd">
	<extension abstractclassprefix="Generated" classprefix="Jevintegration" name="jevintegration"
			description="Decisions about shop text with TypeSafe's Jev: review moderation, category and attribute suggestions, dry runs on your own data, an audit record per decision">
		<requires-extension name="customerreview"/>
		<requires-extension name="catalog"/>
		<!-- for the Apply and Dismiss actions in backoffice/src: they sit in its admin cockpit, as in SAP's own modules -->
		<requires-extension name="platformbackoffice"/>
		<coremodule generated="true" manager="de.hybris.platform.jalo.extension.GenericManager" packageroot="org.jevintegration"/>
		<!-- Backoffice config in resources/, the actions in backoffice/ -->
		<meta key="backoffice-module" value="true"/>
	</extension>
</extensioninfo>
