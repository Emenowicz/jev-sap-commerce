<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="jevClient" class="org.jevintegration.JevClient">
		<constructor-arg value="${jev.api.url}"/>
		<constructor-arg value="${jev.api.key}"/>
		<constructor-arg value="${jev.model}"/>
		<constructor-arg value="${jev.timeout.ms}"/>
		<constructor-arg value="${jev.max.attempts}"/>
	</bean>

	<!-- Live: moderates pending reviews. -->
	<bean id="jevReviewModerationJob" class="org.jevintegration.review.JevReviewModerationJob" parent="abstractJobPerformable">
		<property name="jevClient" ref="jevClient"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="dryRun" value="false"/>
	</bean>

	<!-- Dry run: judges reviews your moderators already decided and changes nothing. -->
	<bean id="jevReviewDryRunJob" parent="jevReviewModerationJob">
		<property name="dryRun" value="true"/>
	</bean>
	<!-- Suggest: records a category suggestion for products without one. Never changes a product. -->
	<bean id="jevCategorySuggestionJob" class="org.jevintegration.category.JevCategorySuggestionJob" parent="abstractJobPerformable">
		<property name="jevClient" ref="jevClient"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="catalogVersionService" ref="catalogVersionService"/>
		<property name="categoryService" ref="categoryService"/>
		<property name="dryRun" value="false"/>
	</bean>

	<!-- Dry run: suggests categories for products that already have one, to compare. -->
	<bean id="jevCategoryDryRunJob" parent="jevCategorySuggestionJob">
		<property name="dryRun" value="true"/>
	</bean>
</beans>
