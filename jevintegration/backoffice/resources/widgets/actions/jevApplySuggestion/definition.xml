<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<action-definition id="org.jevintegration.backoffice.apply"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/action-definition.xsd">

	<name>Apply suggestion</name>
	<description>Applies Jev's category or attribute suggestion to the product</description>
	<author>jevintegration</author>
	<version>1.0</version>

	<iconUri>accept</iconUri>

	<actionClassName>org.jevintegration.backoffice.ApplySuggestionAction</actionClassName>

	<!-- one judgment from the editor, a collection from the list view -->
	<inputType>java.lang.Object</inputType>
	<outputType>java.lang.Object</outputType>

	<settings>
		<setting key="viewMode" default-value="iconAndText"/>
	</settings>

</action-definition>
