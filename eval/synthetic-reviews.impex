# 80 synthetic, labelled product reviews for measuring jevintegration's review moderation:
# 10 approved + 10 rejected in each of en, de, fr, it. The id (en-01 ... it-20) is in the alias, which is not sent to Jev.
# Approved includes harsh but legitimate criticism (04-06), which a moderator must not reject.
# Rejected: insults (11-12), a threat (13), harassment (14), spam (15-16), gibberish (17), off-topic (18),
# prompt injection with spam (19), and a third person's contact details (20, placeholder data).
# Use: import into a sandbox that has jevintegration, run jevReviewDryRunCronJob, compare with results-jev-1.13.0.tsv.
INSERT_UPDATE Catalog; id[unique = true]
; jevEval
INSERT_UPDATE CatalogVersion; catalog(id)[unique = true]; version[unique = true]
; jevEval ; Staged
INSERT_UPDATE Product; code[unique = true]; catalogVersion(catalog(id), version)[unique = true]; name[lang = en]; name[lang = de]; name[lang = fr]; name[lang = it]
; drill ; jevEval:Staged ; Cordless drill 18V ; Akku-Bohrschrauber 18V ; Perceuse-visseuse sans fil 18V ; Trapano avvitatore a batteria 18V

