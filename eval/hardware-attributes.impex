# Classification for measuring attribute suggestions: one class, 'hardware', with three enum attributes from
# Shopify's Product Taxonomy v2026-02 (Power source, Hardware material, Color) and all their values, in English,
# German, French and Italian. Set jev.attribute.catalog=jevEval, jev.attribute.system=jevEvalClassification.
# Import hardware-categories.impex and synthetic-products.impex first, then hardware-attribute-values.impex.
#
# Attribute and value names: Shopify Product Taxonomy (https://github.com/Shopify/product-taxonomy), MIT License,
# Copyright (c) Shopify. The full notice is in hardware-categories.impex.
INSERT_UPDATE ClassificationSystem; id[unique = true]
; jevEvalClassification
INSERT_UPDATE ClassificationSystemVersion; catalog(id)[unique = true]; version[unique = true]; active
; jevEvalClassification ; 1.0 ; true

INSERT_UPDATE ClassificationClass; code[unique = true]; catalogVersion(catalog(id), version)[unique = true]; name[lang = en]; name[lang = de]; name[lang = fr]; name[lang = it]
; hardware ; jevEvalClassification:1.0 ; "Hardware attributes" ; "Heimwerker-Merkmale" ; "Caractéristiques quincaillerie" ; "Caratteristiche ferramenta"

