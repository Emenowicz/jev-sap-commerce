# Labels for measuring attribute suggestions: puts all 40 products of synthetic-products.impex into the 'hardware'
# class of hardware-attributes.impex, and sets a value only where the product text clearly states it (21 values).
# Every other attribute stays empty, so the suggestion run also shows how often Jev fills what the text doesn't say.
$clAttrModifiers = system = 'jevEvalClassification', version = '1.0', translator = de.hybris.platform.catalog.jalo.classification.impex.ClassificationAttributeTranslator

UPDATE Product; code[unique = true]; catalogVersion(catalog(id), version)[unique = true]; supercategories(code, catalogVersion(catalog(id), version))[mode = append]
; eval-p01 ; jevEval:Staged ; hardware:jevEvalClassification:1.0
